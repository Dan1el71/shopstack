# Copy this file to development/.env and fill in real values.
#
# `docker compose` reads .env from this directory. These variables have no
# defaults in docker-compose.yml, so `docker compose up` fails fast (and names
# the missing variable) while any of them is unset or empty.
# .env is git-ignored - never commit real credentials.

# shopstack-server - HS256 signing secret for JWT tokens.
# Use a long random value (32+ bytes), e.g. `openssl rand -hex 32`.
JWT_SECRET=

# shopstack-payment-service - Stripe secret API key (sk_test_... / sk_live_...).
STRIPE_API_KEY=

# shopstack-notification-service - SMTP account and password/app-password.
MAIL_USERNAME=
MAIL_PASSWORD=
